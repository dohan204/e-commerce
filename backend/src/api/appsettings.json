{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit" : {
    "PermitLimit": 30,
    "Window": 500,
    "SegmentsPerWindow": 3,
    "QueueLimit": 3
  },
  "Caches": {
    "AbsoluteExpiration": 30,
    "SlidingExpiration": 10
  }
}